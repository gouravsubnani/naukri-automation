# ============================================================
# Naukri Automation — Configuration
# ============================================================
# 1. Copy this file:  copy .env.example .env
# 2. Fill in the resume path below.
# 3. NEVER commit .env to version control.
# ============================================================

# Absolute path to the resume file you want to upload daily
# Use forward slashes or escaped backslashes on Windows
RESUME_PATH=C:/Users/yourname/Documents/MyResume.pdf

# ============================================================
# Authentication is handled via cookies (not email/password).
# Run 'python export_cookies.py' to generate naukri_cookies.json
# For GitHub Actions, the cookies are stored as NAUKRI_COOKIES secret.
# ============================================================
