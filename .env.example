# ============================================================
# Naukri Automation — Configuration
# ============================================================
# 1. Copy this file:  copy .env.example .env
# 2. Fill in your real credentials and path below.
# 3. NEVER commit .env to version control.
# ============================================================

# Your Naukri.com login credentials
NAUKRI_EMAIL=your_email@example.com
NAUKRI_PASSWORD=your_password_here

# Absolute path to the resume file you want to upload daily
# Use forward slashes or escaped backslashes on Windows
RESUME_PATH=C:/Users/gousubna/Documents/MyResume.pdf
